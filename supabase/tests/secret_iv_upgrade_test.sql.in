-- Replay the actual migration against populated legacy storage, using only
-- transaction-local synthetic data. Expected plaintext is independent of the
-- old text-to-bytea cast, which interpreted backslashes during a backfill.
BEGIN;
SELECT no_plan();
DO $fixture$
DECLARE existing uuid;
BEGIN
    SELECT id INTO existing FROM vault.secrets WHERE name = 'master_encryption_key';
    IF existing IS NULL THEN
        PERFORM vault.create_secret('iv-test-key-0123456789abcdef01234567', 'master_encryption_key', 'pgTAP only');
    ELSE
        PERFORM vault.update_secret(existing, 'iv-test-key-0123456789abcdef01234567', 'master_encryption_key', 'pgTAP only');
    END IF;
END;
$fixture$;
CREATE TEMP TABLE iv_expected AS
SELECT $plain$literal\path\\double\123 雪$plain$::text AS password,
       '["code\\\\path","雪"]'::text AS recovery,
       'JBSWY3DPEHPK3PXP'::text AS totp;
CREATE FUNCTION pg_temp.legacy_iv_encrypt(value text) RETURNS text LANGUAGE sql AS $$
    SELECT encode(extensions.encrypt(convert_to(value, 'utf8'),
        public.get_encryption_key()::bytea, 'aes'), 'base64');
$$;
INSERT INTO auth.users(id, email) VALUES
    ('d1800000-0000-4000-8000-000000000021', 'iv-upgrade@pgtap.test');
INSERT INTO public.secrets(id,user_id,website,username,password_encrypted)
SELECT 'd1800000-0000-4000-8000-000000000022',
    'd1800000-0000-4000-8000-000000000021', 'iv-upgrade.test','owner',
    pg_temp.legacy_iv_encrypt(password) FROM iv_expected;
ALTER TABLE public.secret_metadata DISABLE TRIGGER encrypt_twofa_secret_trigger;
INSERT INTO public.secret_metadata(secret_id,twofa_enabled,twofa_type,twofa_secret,recovery_codes_encrypted)
SELECT 'd1800000-0000-4000-8000-000000000022', true,'app',
    'v1:' || pg_temp.legacy_iv_encrypt(totp), pg_temp.legacy_iv_encrypt(recovery)
FROM iv_expected;
ALTER TABLE public.secret_metadata ENABLE TRIGGER encrypt_twofa_secret_trigger;

\ir ../migrations/20260914000000_randomize_secret_encryption_iv.sql

SELECT is(public.decrypt_text(s.password_encrypted), e.password,
    'real migration preserves backslashes and Unicode in legacy password bytes')
FROM public.secrets s CROSS JOIN iv_expected e WHERE s.website='iv-upgrade.test';
SELECT is(public.decrypt_text(m.recovery_codes_encrypted), e.recovery,
    'real migration preserves legacy recovery-code JSON bytes')
FROM public.secret_metadata m CROSS JOIN iv_expected e
WHERE m.secret_id='d1800000-0000-4000-8000-000000000022';
SELECT is(public.safe_decrypt_twofa_secret(m.twofa_secret), e.totp,
    'real migration preserves legacy TOTP through the application reader')
FROM public.secret_metadata m CROSS JOIN iv_expected e
WHERE m.secret_id='d1800000-0000-4000-8000-000000000022';
SELECT ok(s.password_encrypted LIKE 'v2:%'
    AND m.recovery_codes_encrypted LIKE 'v2:%' AND m.twofa_secret LIKE 'v1:v2:%',
    'all three populated fields receive their correct storage envelopes')
FROM public.secrets s JOIN public.secret_metadata m ON m.secret_id=s.id
WHERE s.website='iv-upgrade.test';
SELECT is(tgenabled, 'O'::"char", 'migration restores the TOTP input trigger')
FROM pg_trigger WHERE tgrelid='public.secret_metadata'::regclass
AND tgname='encrypt_twofa_secret_trigger';
SELECT is(public.decrypt_text(public.encrypt_text(password)), password,
    'new plaintext writes preserve literal backslashes and Unicode') FROM iv_expected;
SELECT is(public.decrypt_text(public.encrypt_text('')), '', 'empty plaintext round trips');
SELECT is(public.decrypt_text(public.encrypt_text(NULL)), NULL, 'null plaintext round trips');
CREATE TEMP TABLE iv_snapshot AS
SELECT s.password_encrypted,m.recovery_codes_encrypted,m.twofa_secret
FROM public.secrets s JOIN public.secret_metadata m ON m.secret_id=s.id
WHERE s.website='iv-upgrade.test';

\ir ../migrations/20260914000000_randomize_secret_encryption_iv.sql

SELECT results_eq(
    $$SELECT s.password_encrypted,m.recovery_codes_encrypted,m.twofa_secret
      FROM public.secrets s JOIN public.secret_metadata m ON m.secret_id=s.id
      WHERE s.website='iv-upgrade.test'$$,
    $$SELECT * FROM iv_snapshot$$, 'replaying the real migration leaves every envelope byte-identical');
SELECT throws_ok($$UPDATE public.secret_metadata SET twofa_secret='v1:copied-envelope'
    WHERE secret_id='d1800000-0000-4000-8000-000000000022'$$,
    '22023', 'TOTP input must be plaintext, not a storage envelope',
    'restored trigger rejects importing a stored envelope');
UPDATE public.secret_metadata SET twofa_secret='NEWPLAINTEXTSEED'
WHERE secret_id='d1800000-0000-4000-8000-000000000022';
SELECT is(public.safe_decrypt_twofa_secret(twofa_secret),'NEWPLAINTEXTSEED',
    'restored trigger accepts plaintext and encrypts in the new format')
FROM public.secret_metadata WHERE secret_id='d1800000-0000-4000-8000-000000000022';
-- Corruption fails closed before any row or trigger is changed, with a
-- column-specific recovery hint rather than leaking a value in diagnostics.
ALTER TABLE public.secret_metadata DISABLE TRIGGER encrypt_twofa_secret_trigger;
UPDATE public.secret_metadata SET twofa_secret='v1:invalid!'
WHERE secret_id='d1800000-0000-4000-8000-000000000022';
ALTER TABLE public.secret_metadata ENABLE TRIGGER encrypt_twofa_secret_trigger;
SELECT throws_ok($migration$
\ir ../migrations/20260914000000_randomize_secret_encryption_iv.sql
$migration$, 'P0001',
    'IV upgrade refused: 1 unreadable rows in public.secret_metadata.twofa_secret; recover these rows with the correct key before retrying',
    'unreadable TOTP aborts the actual migration with column-only diagnostics');
SELECT is(twofa_secret, 'v1:invalid!', 'failed upgrade preserves the unreadable row')
FROM public.secret_metadata WHERE secret_id='d1800000-0000-4000-8000-000000000022';
SELECT is(tgenabled, 'O'::"char", 'failed upgrade leaves TOTP encryption enabled')
FROM pg_trigger WHERE tgrelid='public.secret_metadata'::regclass
AND tgname='encrypt_twofa_secret_trigger';
SELECT * FROM finish();
ROLLBACK;
