/**
 * Template build.gradle.kts for out-of-process plugins.
 *
 * Copy this to your plugin module and adjust:
 * - group, version
 * - mainClass in shadowJar manifest
 * - dependencies specific to your plugin
 */
plugins {
    alias(libs.plugins.kotlinJvm)
    alias(libs.plugins.kotlinSerialization)
    // Shadow plugin for creating fat JARs
    id("com.gradleup.shadow") version "9.1.0"
}

group = "ai.rever.boss.plugin.sample"
version = "1.0.0"

java {
    toolchain {
        languageVersion.set(JavaLanguageVersion.of(17))
    }
}

dependencies {
    // Plugin API and IPC (provided by host runtime - don't bundle)
    compileOnly(project(":plugin-platform:plugin-api-core"))
    compileOnly(project(":boss-ipc"))
    compileOnly(project(":boss-ui-sdk"))

    // Plugin's own dependencies
    implementation(libs.kotlinx.serialization.json)
    implementation(libs.kotlinx.coroutines.core)

    // Unit testing dependencies
    testImplementation(kotlin("test"))
    testImplementation(project(":boss-ui-sdk"))
}

tasks.shadowJar {
    archiveClassifier.set("all")
    mergeServiceFiles()

    // The child's entry point (PluginProcessMainKt) lives in the standalone
    // boss-microkernel-runtime JAR (separate repository). The host adds that
    // jar to the child classpath at spawn time (BOSS_PLUGIN_RUNTIME_JAR or the
    // probed default location), so do NOT bundle it here. For standalone
    // debugging, keep it out of the shadow JAR and add it to the -cp line:
    //   compileOnly(files("libs/boss-microkernel-runtime-<version>.jar"))
    manifest {
        attributes["Main-Class"] = "ai.rever.boss.plugin.runtime.PluginProcessMainKt"
    }
}

// Copy the fat JAR to the plugins directory for development
tasks.register<Copy>("deployPlugin") {
    dependsOn(tasks.shadowJar)
    from(tasks.shadowJar.get().archiveFile)
    into("${rootProject.projectDir}/composeApp/build/bundled-plugins")
}
