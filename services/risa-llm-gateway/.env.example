# Never commit the populated .env file.
CW_API_TOKEN=
CW_INFERENCE_BASE_URL=https://YOUR_GATEWAY.gw.cwinference.com/v1
CW_SERVED_MODEL=openai/YOUR_SERVED_MODEL

# Must start with sk-. Generate a high-entropy random value.
LITELLM_MASTER_KEY=sk-replace-me
POSTGRES_PASSWORD=replace-me

SUPABASE_URL=https://api.risaboss.com
SUPABASE_ANON_KEY=
RISA_LLM_ALLOWED_EMAILS=pilot-one@risalabs.ai,pilot-two@risalabs.ai

# Optional limits for a single user key.
RISA_LLM_KEY_DURATION=8h
RISA_LLM_KEY_REFRESH_SECONDS=21600
RISA_LLM_RPM_LIMIT=60
RISA_LLM_TPM_LIMIT=500000
