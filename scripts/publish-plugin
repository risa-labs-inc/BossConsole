#!/usr/bin/env bash
# Publish a plugin using Python's JSON and HTTP libraries. Credentials stay in the environment.
set -euo pipefail
for argument in "$@"; do
    case "$argument" in
        --token|--token=*)
            printf '%s\n' 'Set BOSS_PLUGIN_STORE_TOKEN in the environment; token arguments are no longer accepted.' >&2
            exit 2
            ;;
    esac
done
if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' 'Python 3 is required to publish a plugin.' >&2
    exit 1
fi
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$script_dir/publish_plugin.py" "$@"
